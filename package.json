{
  "name": "vibe-kanban",
  "packageManager": "pnpm@9.15.9",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc || exit 0",
    "watch": "tsc -w",
    "start": "node dist/server.js",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts && tsx --test test/api.test.ts && tsx --test test/orchestration.test.ts && tsx --test test/opencode_integration.test.ts && tsx --test test/worktree_utils.test.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "kind:up": "./scripts/kind-up.sh",
    "kind:down": "./scripts/kind-down.sh",
    "cli": "node dist/cli/vibe.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.21.0",
    "@types/three": "^0.183.1",
    "commander": "^15.0.0",
    "playwright": "^1.61.0",
    "three": "^0.185.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/openai": "^4.0.7",
    "@google/genai": "^2.8.0",
    "@opeoginni/github-copilot-openai-compatible": "^1.0.0",
    "ai": "^7.0.28",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "execa": "^9.6.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0"
  }
}
