{
  "name": "vibe-kanban",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/server.js",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts && tsx --test test/api.test.ts && tsx --test test/orchestration.test.ts && tsx --test test/opencode_integration.test.ts && tsx --test test/worktree_utils.test.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "kind:up": "./scripts/kind-up.sh",
    "kind:down": "./scripts/kind-down.sh",
    "cli": "node dist/cli/vibe.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.2",
    "@types/node-fetch": "^2.6.11",
    "@types/three": "^0.183.1",
    "commander": "^14.0.3",
    "three": "^0.183.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@google/genai": "^1.50.1",
    "@opeoginni/github-copilot-openai-compatible": "^1.0.0",
    "ai": "^6.0.174",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "playwright": "^1.60.0"
  }
}
