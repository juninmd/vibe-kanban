{
  "name": "vibe-kanban",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/server.js",
    "pretest": "pnpm build",
    "test": "node --test test/unit/*.test.js && node --test test/api.test.js && node --test test/orchestration.test.js && node --test test/opencode_integration.test.js && node --test test/worktree_utils.test.js",
    "test:cov": "c8 --reporter=lcov --reporter=text node --test test/unit/*.test.js && node --test test/api.test.js && node --test test/orchestration.test.js && node --test test/opencode_integration.test.js && node --test test/worktree_utils.test.js",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "kind:up": "./scripts/kind-up.sh",
    "kind:down": "./scripts/kind-down.sh",
    "cli": "node dist/cli/vibe.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.7",
    "@types/node-fetch": "^2.6.11",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "c8": "^11.0.0",
    "commander": "^12.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "three": "^0.160.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "execa": "^9.6.0",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.58.2"
  }
}
