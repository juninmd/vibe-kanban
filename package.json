{
  "name": "vibe-kanban",
  "packageManager": "pnpm@10.34.5",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc || exit 0",
    "watch": "tsc -w",
    "start": "node dist/server.js",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts && tsx --test test/api.test.ts && tsx --test test/orchestration.test.ts && tsx --test test/opencode_integration.test.ts && tsx --test test/worktree_utils.test.ts && tsx --test test/roadmapTasks.test.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "kind:up": "./scripts/kind-up.sh",
    "kind:down": "./scripts/kind-down.sh",
    "cli": "node dist/cli/vibe.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.0",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.21.0",
    "@types/three": "^0.187.0",
    "commander": "^15.1.0",
    "playwright": "^1.61.0",
    "three": "^0.187.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.117",
    "@ai-sdk/openai": "^4.0.114",
    "@google/genai": "^3.1.0",
    "@opeoginni/github-copilot-openai-compatible": "^1.0.0",
    "ai": "^7.0.169",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.10",
    "execa": "^10.2.1",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@7.5.5": ">=7.6.1 <8.0.0"
    }
  }
}
