{
  "name": "vibe-kanban",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "start": "node dist/server.js",
    "pretest": "pnpm build",
    "test": "node --test test/unit/*.test.js && node --test test/api.test.js && node --test test/orchestration.test.js && node --test test/opencode_integration.test.js && node --test test/worktree_utils.test.js",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "kind:up": "./scripts/kind-up.sh",
    "kind:down": "./scripts/kind-down.sh",
    "cli": "node dist/cli/vibe.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/node-fetch": "^2.6.11",
    "@types/three": "^0.183.1",
    "commander": "^14.0.3",
    "three": "^0.183.2",
    "tsx": "^4.7.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "execa": "^9.6.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "playwright": "^1.58.2"
  }
}
